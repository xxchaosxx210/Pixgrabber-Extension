{
  "name": "Pix Thumbnail Grabber",
  "version": "0.2.0",
  "description": "Pick and choose groups of thumbnails to download with the PixGrabber desktop application.",
  "manifest_version": 3,
  "minimum_chrome_version": "90",
  "icons": {
    "16": "images/pix16.png",
    "32": "images/pix32.png",
    "48": "images/pix48.png",
    "128": "images/pix128.png"
  },
  "author": "Paul Millar",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "images/pix16.png",
      "32": "images/pix32.png",
      "48": "images/pix48.png",
      "128": "images/pix128.png"
    },
    "default_title": "PixGrabber Helper"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html",
        "frame.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
